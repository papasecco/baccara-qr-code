# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # service_role key (segreta, solo lato server)

# Invio mail via SMTP (casella del dominio)
SMTP_HOST=mail.tuodominio.it
SMTP_PORT=587
SMTP_USER=info@tuodominio.it
SMTP_PASS=password-della-casella
EMAIL_FROM="Nome Locale <info@tuodominio.it>"

# Typeform — genera una stringa a caso, la userai come "secret" nel webhook Typeform
TYPEFORM_WEBHOOK_SECRET=cambia-questa-stringa-a-caso

# Password condivisa per accedere a /scan e /dashboard (staff del locale)
STAFF_PASSWORD=cambia-questa-password

# Usato per firmare il cookie di sessione dello staff (stringa lunga a caso)
SESSION_SECRET=cambia-anche-questa-stringa-lunga-e-casuale

# URL pubblico dell'app una volta deployata (usato nei link/QR se servisse)
NEXT_PUBLIC_APP_URL=https://tuo-progetto.vercel.app
